"AppBuild"
{
	"AppID" "{{APP_ID}}"
	"Desc" "{{DESC}}"
	"ContentRoot" "{{CONTENT_ROOT}}"
	"BuildOutput" "{{BUILD_OUTPUT}}"
	"SetLive" "{{SET_LIVE}}"
	"Depots"
	{
		"{{DEPOT_ID}}"
		{
			"FileMapping"
			{
				"LocalPath" "*"
				"DepotPath" "."
				"recursive" "1"
			}
			"FileExclusion" "*.pdb"
			"FileExclusion" "steam_appid.txt"
		}
	}
}
